# Copy to .env.local and fill in from Firebase console > Project settings > Your apps (Web)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Hurst's Google Place ID (Google "Place ID Finder")
NEXT_PUBLIC_GOOGLE_PLACE_ID=

# URL of the deployed getReviews function, e.g. https://us-central1-YOUR-PROJECT.cloudfunctions.net/getReviews
NEXT_PUBLIC_REVIEWS_URL=
