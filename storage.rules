rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Inquiry photos: upload-only, images under 10 MB. No public reads.
    match /inquiries/{inquiryId}/{file} {
      allow create: if request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow read, update, delete: if false;
    }
    // Site photos uploaded from /admin: public read, editors (listed in Firestore /admins) upload images under 15 MB.
    match /site/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid))
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
