rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Inquiry photos: upload-only, images under 10 MB. No public reads.
    match /inquiries/{inquiryId}/{file} {
      allow create: if request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow read, update, delete: if false;
    }
    // Site photos uploaded from /admin: public read; editors upload images under 15 MB.
    // Editor user IDs must match the docs in Firestore /admins (add new editors in both places).
    match /site/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid in ['f6u6Nc0WHHZCopG1UiTXwuA0kqF3']
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
